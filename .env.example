# Required in production. 32+ characters. Encrypts model API keys before they
# are stored in an httpOnly cookie. In development an ephemeral key is used.
MODEL_CREDENTIALS_SECRET=

# Set to true only when model endpoints on localhost or a private network are
# intentional (for example a local Ollama/LM Studio server). Production blocks
# private endpoints by default to reduce SSRF exposure.
ALLOW_PRIVATE_MODEL_ENDPOINTS=false

# Server-side request timeout for a single model step.
AI_REQUEST_TIMEOUT_MS=60000
